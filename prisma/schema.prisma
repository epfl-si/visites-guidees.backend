// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id
  lastName  String   @map("last_name")
  firstName String   @map("first_name")
  email     String   @unique
  username  String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  guide Guide?

  @@map("users")
}

model Guide {
  id     Int         @id @default(autoincrement())
  status GuideStatus @default(ACTIVE)
  phone  String[]

  user              User               @relation(fields: [id], references: [id])
  reservationGuides ReservationGuide[]
  languages         Language[]
  blockedPeriods    BlockedPeriod[]

  @@map("guides")
}

model Reservation {
  id                Int               @id @default(autoincrement())
  date              DateTime
  firstName         String            @map("first_name")
  lastName          String            @map("last_name")
  email             String
  phone             String
  address           String
  additionalAddress String?           @map("additional_address")
  city              String
  zip               String
  region            String
  country           String
  company           String?
  payment           String
  participantNumber Int               @map("participant_number")
  status            ReservationStatus @default(WAITINGGUIDE)
  languageId        Int               @map("language_id")
  placeId           Int               @map("place_id")
  comment           String?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  language          Language           @relation(fields: [languageId], references: [id])
  place             Place              @relation(fields: [placeId], references: [id])
  reservationGuides ReservationGuide[]

  @@map("reservations")
}

model BlockedPeriod {
  id        Int      @id @default(autoincrement())
  label     Json
  start     DateTime
  end       DateTime
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  places Place[]
  guides Guide[]

  @@map("blocked_periods")
}

model Language {
  id   Int    @id @default(autoincrement())
  code String @unique
  name String @unique

  reservations Reservation[]
  guides       Guide[]
  places       Place[]

  @@map("languages")
}

model Place {
  id          Int      @id @default(autoincrement())
  title       Json
  description Json
  picture     String
  capacity    Int
  price       Int
  conditions  Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  reservations   Reservation[]
  languages      Language[]
  blockedPeriods BlockedPeriod[]

  @@map("places")
}

model ReservationGuide {
  reservationId Int                    @map("reservation_id")
  guideId       Int                    @map("guide_id")
  status        ReservationGuideStatus @default(WAITING)
  assignedAt    DateTime               @default(now()) @map("assigned_at")
  updatedAt     DateTime               @default(now()) @map("updated_at")

  reservation Reservation @relation(fields: [reservationId], references: [id])
  guide       Guide       @relation(fields: [guideId], references: [id])

  @@id([reservationId, guideId])
  @@map("reservations_guides")
}

enum ReservationStatus {
  WAITINGGUIDE
  WAITINGVALIDATION
  WAITINGPAYMENT
  READY
  CANCELLED
}

enum GuideStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  RETIRED
}

enum ReservationGuideStatus {
  ACCEPTED
  DECLINED
  WAITING
  CHOSEN
}
