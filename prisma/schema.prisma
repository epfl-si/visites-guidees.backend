// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model reservations {
  id                  Int               @id @default(autoincrement())
  firstName           String
  lastName            String
  company             String?
  email               String
  phone               String
  address             String
  additionnalAddress  String?
  city                String
  zip                 Int
  region              String
  country             String
  visitDate           DateTime          @default(now())
  createdAt           DateTime          @default(now())
  payment             String
  numberOfParticipant Int
  statusId            Int
  languageId          Int
  placeId             Int
  comments            String?
  status              status            @relation(fields: [statusId], references: [id])
  language            languages         @relation(fields: [languageId], references: [id])
  place               places            @relation(fields: [placeId], references: [id])
  reservationGuide    reservationGuide?
}

model blockedPeriods {
  id                  Int                  @id @default(autoincrement())
  label               String
  startDatetime       DateTime
  endDatetime         DateTime
  createdAt           DateTime             @default(now())
  blockedPeriodPlaces blockedPeriodPlace[]
  blockedPeriodGuides blockedPeriodGuide[]
}

model languages {
  id             Int             @id @default(autoincrement())
  name           String
  reservations   reservations[]
  guideLanguages guideLanguage[]
  placeLanguages placeLanguage[]
}

model Users {
  sciper      Int       @id
  lastName    String
  firstName   String
  email       String    @unique
  gaspar      String    @unique
  guideInfo   guideInfo?
}

model places {
  id                  Int                  @id @default(autoincrement())
  title               Json
  picture             String
  description         Json
  createdAt           DateTime             @default(now())
  maxPerGroup         Int
  price               Int
  conditions          Json
  placeLanguages      placeLanguage[]
  reservations        reservations[]
  blockedPeriodPlaces blockedPeriodPlace[]
}

model placeLanguage {
  placeId    Int
  languageId Int
  place      places    @relation(fields: [placeId], references: [id])
  language   languages @relation(fields: [languageId], references: [id])

  @@id([placeId, languageId])
}

model blockedPeriodPlace {
  placeId         Int
  blockedPeriodId Int
  blockedPeriod   blockedPeriods @relation(fields: [blockedPeriodId], references: [id])
  place           places         @relation(fields: [placeId], references: [id])

  @@id([placeId, blockedPeriodId])
}

model guideLanguage {
  guideId    Int
  languageId Int
  guide      guideInfo @relation(fields: [guideId], references: [sciper])
  language   languages @relation(fields: [languageId], references: [id])

  @@id([guideId, languageId])
}

model blockedPeriodGuide {
  guideSciper     Int
  blockedPeriodId Int
  blockedPeriod   blockedPeriods @relation(fields: [blockedPeriodId], references: [id])
  guide           guideInfo      @relation(fields: [guideSciper], references: [sciper])

  @@id([guideSciper, blockedPeriodId])
}

model status {
  id                Int                @id @default(autoincrement())
  status            String
  reservations      reservations[]
  reservationGuides reservationGuide[]
  guideInfos        guideInfo[]
}

model reservationGuide {
  reservationId Int          @id
  guideSciper   Int
  updatedAt     DateTime     @default(now())
  statusId      Int
  reservation   reservations @relation(fields: [reservationId], references: [id])
  guide         guideInfo    @relation(fields: [guideSciper], references: [sciper])
  status        status       @relation(fields: [statusId], references: [id])
}

model guideInfo {
  sciper              Int                  @id @unique
  statusId            Int
  phone               String
  status              status               @relation(fields: [statusId], references: [id])
  user                Users                @relation(fields: [sciper], references: [sciper])
  guideLanguages      guideLanguage[]
  blockedPeriodGuides blockedPeriodGuide[]
  reservationGuide    reservationGuide[]
}
